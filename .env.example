# Copy to .env.local and fill in your own values.
# Never commit a real bearer token.

VITE_API_BASE_URL=https://your-server.example.com
VITE_USE_PROXY=true
VITE_ORGANIZATION_ID=1
# Pre-fills the login form only — does not auto-sign-in.
VITE_BEARER_TOKEN=
VITE_USER_ID=0
VITE_WORK_EMAIL=user@example.invalid
